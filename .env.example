# --- Scheduler database (Supabase) ---
# The schedule maker at /admin reads and writes these tables. Both are required;
# without them /admin shows a setup notice instead of the dashboard.

# Project Settings -> Data API -> Project URL.
SUPABASE_URL=https://ubotsksjsqjhfrsqcrna.supabase.co

# Project Settings -> API Keys -> service_role.
# This key bypasses every access rule in the database. It is read only by server
# code (never shipped to the browser), so keep it out of NEXT_PUBLIC_* names and
# out of version control.
SUPABASE_SERVICE_ROLE_KEY=

# --- Staff admin dashboard (/admin) ---
# Password for the owner-only schedule maker. The login is disabled entirely
# until this is set, both locally and in Vercel. Use quotes if it contains a $.
ADMIN_PASSWORD=

# Optional. Signs the admin session cookie; defaults to ADMIN_PASSWORD when
# unset, which is fine. Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# --- Menu descriptions (/admin/menu-descriptions) ---
# Claude API key for the "Generate" button, which writes a recipe's menu
# description and taste profile. Create one at https://platform.claude.com.
# Without it everything else on that page works; generating is just switched off.
# Server-only — never give it a NEXT_PUBLIC_ name.
ANTHROPIC_API_KEY=

# Careers application emails (Resend). Copy to .env.local and fill in.
# Without RESEND_API_KEY the form still works in dev but no emails are sent.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Sender address on a domain you've verified in Resend.
# For quick testing you may use: "JP's Hot Chicken Careers <onboarding@resend.dev>"
CAREERS_FROM_EMAIL="JP's Hot Chicken Careers <careers@jpshotchicken.com>"

# Where new applications are emailed (defaults to siteConfig.email if unset).
CAREERS_NOTIFY_EMAIL=jpshotchicken@gmail.com

# --- Applications spreadsheet (Google Sheets via Apps Script) ---
# When set, every application is also appended as a row to your Google Sheet.
# See docs/applications-sheet-setup.md for the one-time setup.
# The "/exec" web-app URL from your Apps Script deployment:
SHEETS_WEBHOOK_URL=
# Optional shared secret — must match the TOKEN in the Apps Script. Leave both
# blank to skip the check, or set a long random string in both places.
SHEETS_WEBHOOK_TOKEN=

# --- Operations (/operations) ---
# Shared four digit code the crew types to reach the shift tools. Optional:
# unset, the built-in code applies. Set it here and in Vercel to change the code
# without a deploy — it must be four digits, since that is what the sign-in draws.
# Changing it signs every unlocked device out.
OPERATIONS_CODE=

# --- Google Ads conversion tracking (paid search landing pages) ---
# All optional. With NEXT_PUBLIC_GOOGLE_ADS_ID unset, no Google Ads script is
# loaded at all and every tracked button behaves like a normal link — so the
# site is safe to deploy before the Ads account is wired up.
#
# ⚠️ Online ordering is hosted off-site (Toast / SkyTab), so the "order"
# conversion counts CLICKS THROUGH to the ordering platform, not completed
# orders. It overcounts. Use it to compare keywords, never as revenue, and do
# not switch to Target ROAS bidding on the strength of it.
#
# Google Ads -> Goals -> Conversions -> the action -> "Tag setup" -> "Install
# the tag yourself". The snippet shown there contains both values:
#   send_to: 'AW-123456789/AbC-D_efGh12345'
#            └── the ID ──┘ └── the label ─┘
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_ORDER_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_CALL_LABEL=

# --- Catering enquiries (landing page form) ---
# Both fall back to the careers equivalents, then to siteConfig.email, so the
# form works without these set. Uses the same RESEND_API_KEY as careers.
CATERING_FROM_EMAIL="JP's Hot Chicken <catering@jpshotchicken.com>"
CATERING_NOTIFY_EMAIL=jpshotchicken@gmail.com
